// Hosts the analyzer on Cloudflare at azure-tiers.mohammedsaif.dev: the built React app from
// frontend/dist, with /api answered by worker/index.js. The workers.dev address and preview
// links stay off, because they carry the Cloudflare account's name.
{
  "name": "azure-storage-tier-analyzer",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "azure-tiers.mohammedsaif.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.csv"], "fallthrough": true }
  ]
}
